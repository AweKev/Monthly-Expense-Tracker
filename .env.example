# Copy this file to .env and fill it in. .env is ignored by git.

# Database (SQLite for now, PostgreSQL later: postgresql+psycopg://user:pass@host/db)
TRACKER_DB_URL=sqlite:///data/tracker.db

# Gmail
TRACKER_GMAIL_CREDENTIALS=credentials.json
TRACKER_GMAIL_TOKEN=data/token.json
TRACKER_GMAIL_QUERY=from:bankmandiri.co.id

# Names that mean "me" (comma separated, case does not matter).
# A transfer to one of these is an internal transfer, not spending.
TRACKER_OWN_NAMES=KEVIN

# E-wallets you own (used to recognize top-ups; only marked internal if the setting below is false).
TRACKER_OWN_EWALLETS=GOPAY,OVO,DANA,SHOPEEPAY,LINKAJA

# E-wallet money only comes from Mandiri top-ups, so a top-up counts as spending
# (category "Top-up E-wallet"). Set to false only if e-wallet spending itself
# gets tracked later, otherwise it would be counted twice.
TRACKER_COUNT_TOPUPS_AS_SPENDING=true

# Monthly budget in Rupiah (0 = off). Split into a daily allowance:
# (budget - spent this month before today) / days left. Overspend today -> less tomorrow.
TRACKER_MONTHLY_BUDGET=0
# Only used if the monthly budget is 0: same fixed amount every day.
TRACKER_DAILY_BUDGET=0
# Day the budget period starts. 1 = calendar month (1st to end of month).
# 25 = from the 25th to the 24th of next month (e.g. when your monthly money comes in on the 25th).
TRACKER_PERIOD_START_DAY=1

# Telegram bot (phase 2). Token from @BotFather; chat id: send /start to your bot.
TRACKER_TELEGRAM_TOKEN=
TRACKER_TELEGRAM_CHAT_ID=0
TRACKER_SYNC_EVERY_MINUTES=5
TRACKER_SUMMARY_TIME=21:00
# gmail = real emails; eml = read TRACKER_BOT_EML_PATH (try the bot on synthetic data)
TRACKER_BOT_SOURCE=gmail
TRACKER_BOT_EML_PATH=data/synthetic

TRACKER_TIMEZONE=Asia/Jakarta
